canvas#stage.stage

header.nav
  a.nav__logo(href="/") Marginalia
  nav.nav__links
    a(href="#collection") Collection
    a(href="#story") Story
    a(href="#contact") Contact

main.page
  section.hero
    .hero__copy
      p.eyebrow Stationery studio, Lahore
      h1.hero__title
        | Touch
        br
        | the paper.
      p.hero__lead Letterpress notebooks and cards made for people who still write things down. Drag across the page, or click, and it creases.
    .hero__panel(data-warp)

  section.panel#collection
    p.eyebrow The collection
    h2 Three things to write in
    .cards
      article.card
        span.card__tag No. 01
        h3 Field Book
        p Stitched binding, 96 pages of cotton stock.
        span.card__price £18
      article.card
        span.card__tag No. 02
        h3 Pocket Letters
        p A set of twelve folded cards with envelopes.
        span.card__price £14
      article.card
        span.card__tag No. 03
        h3 Desk Pad
        p Tear-off weekly planner, printed in two inks.
        span.card__price £22

  .ribbon(data-warp)

  section.panel#story
    p.eyebrow Story
    h2 Made slowly, on purpose
    ul.list
      li Every sheet is cut and folded by hand in small batches.
      li We print with two inks only, so each colour has to earn its place.
      li Nothing ships until it has been creased, flattened and checked.
      li The paper is sourced from mills that reuse their water.

  section.panel#contact
    p.eyebrow Contact
    h2 Order or say hello
    a.mail(href="mailto:hello@example.com") hello@example.com

  include ../includes/footer.pug
